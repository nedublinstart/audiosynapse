# GPT4Free — primary AI backend (https://github.com/xtekky/gpt4free)
# Free path: Gemini + gemini-* models (no API key required for basic chat).
G4F_MODEL=gemini-3.6-flash
G4F_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-pro
G4F_PROVIDERS=Gemini,AnyProvider,PollinationsAI,DeepSeek,Cerebras,OpenaiChat
# Optional: API key / cookies for stronger authenticated providers
G4F_API_KEY=
G4F_PROXY=

SECRET_KEY=synapse-dev-secret-change-in-production
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/synapse
