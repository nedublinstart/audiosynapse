# ============================================================================
# AI — вариант 1 (рекомендуется, если бесплатные провайдеры блокируются)
# Любой OpenAI-совместимый endpoint: OpenRouter, Groq, DeepSeek, Ollama, LM Studio.
# Примеры:
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
#               AI_MODEL=deepseek/deepseek-chat-v3.1:free
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1
#               AI_MODEL=llama-3.3-70b-versatile
#               AI_TRANSCRIBE_MODEL=whisper-large-v3   (распознавание речи)
#   Ollama:     AI_BASE_URL=http://127.0.0.1:11434/v1
#               AI_MODEL=llama3.1
# ============================================================================
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TRANSCRIBE_MODEL=

# ============================================================================
# AI — вариант 2 (по умолчанию): бесплатные провайдеры GPT4Free.
# Synapse сам пробует их по очереди и запоминает рабочий, поэтому список
# оставляй пустым. Заполняй только если хочешь закрепить конкретные.
# ============================================================================
G4F_PROVIDERS=
G4F_API_KEY=
G4F_PROXY=

# Ограничения попыток (probe — быстрый параллельный поиск провайдера)
AI_TIMEOUT_SECONDS=30
AI_PROBE_TIMEOUT_SECONDS=12
AI_PROBE_WORKERS=6
AI_MAX_ATTEMPTS=8
# AI_DISABLE_G4F=true   # использовать только свой AI_BASE_URL

# Локальное распознавание речи (faster-whisper)
# tiny / base / small / medium / large-v3 — чем больше, тем точнее и медленнее
# small — баланс скорость/качество на CPU (рекомендуется для демо)
WHISPER_MODEL=small
WHISPER_BEAM_SIZE=1
# Приоритет языка: ru (английские термины всё равно сохраняются)
WHISPER_LANGUAGE=ru
# WHISPER_VAD=true          # ускоряет, но может съесть речь — не для полного конспекта
# WHISPER_PREFER_LOCAL=true # локальная полная расшифровка важнее короткого API-ответа
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8
AI_NOTES_TIMEOUT_SECONDS=90
# Макс. секунд на шаг конспекта — потом быстрый черновик по транскрипту
NOTES_PIPELINE_MAX_SECONDS=180

SECRET_KEY=synapse-dev-secret-change-in-production
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/synapse
